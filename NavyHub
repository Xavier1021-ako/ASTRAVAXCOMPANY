	flightAttachment = Instance.new("Attachment")
	flightAttachment.Name = "AstravaxFlightAttachment"
	flightAttachment.Parent = root

	flightVelocity = Instance.new("LinearVelocity")
	flightVelocity.Name = "AstravaxFlightVelocity"
	flightVelocity.Attachment0 = flightAttachment
	flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	flightVelocity.MaxForce = math.huge
	flightVelocity.VectorVelocity = Vector3.zero
	flightVelocity.Parent = root

	flightOrientation = Instance.new("AlignOrientation")
	flightOrientation.Name = "AstravaxFlightOrientation"
	flightOrientation.Attachment0 = flightAttachment
	flightOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	flightOrientation.MaxTorque = math.huge
	flightOrientation.Responsiveness = 25
	flightOrientation.Parent = root

	flyButton.Text = "HERO FLY: ON"
	flyButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)
	status.Text = "SUPERMAN FLIGHT • FREE FLY"

	local currentVelocity = Vector3.zero

	flyConnection = RunService.RenderStepped:Connect(function(dt)
		if not flying or not root or not flightVelocity then
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local direction = Vector3.zero
--================================================
-- DEFAULT ROBLOX MOBILE JOYSTICK
-- LEFT / RIGHT / FORWARD / BACK
--================================================

local moveDirection = humanoid.MoveDirection

if moveDirection.Magnitude > 0.01 then
	-- Use the joystick's movement direction directly.
	-- This gives LEFT + RIGHT + FORWARD + BACK.
	direction += moveDirection
end

		--================================================
		-- PC W/A/S/D
		--================================================

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction += camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction -= camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction -= camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction += camera.CFrame.RightVector
		end

		--================================================
		-- UP
		-- Mobile jump button OR PC Space
		--================================================

		if jumpRequested
			or UserInputService:IsKeyDown(Enum.KeyCode.Space) then

			direction += Vector3.new(0, 1, 0)
			jumpRequested = false
		end

		--================================================
		-- DOWN
		-- PC LeftControl
		--================================================

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.new(0, 1, 0)
		end

		--================================================
		-- NORMALIZE
		--================================================

		if direction.Magnitude > 0.01 then
			direction = direction.Unit
		end

		local targetVelocity = direction * FLY_SPEED

		currentVelocity = currentVelocity:Lerp(
			targetVelocity,
			math.clamp(dt * 10, 0, 1)
		)

		flightVelocity.VectorVelocity = currentVelocity

		--================================================
		-- SUPERMAN FACING
		--================================================

		local lookDirection = direction

		if lookDirection.Magnitude < 0.01 then
			lookDirection = camera.CFrame.LookVector
		end

		flightOrientation.CFrame = CFrame.lookAt(
			root.Position,
			root.Position + lookDirection
		)

		--================================================
		-- AFTERIMAGE
		--================================================

		if effectsEnabled
			and direction.Magnitude > 0
			and math.random() < 0.25 then

			createAfterimage()
		end
	end)
end

local function stopFlight()
	if not flying then
		return
	end

	flying = false
	jumpRequested = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	local crashPosition = root and root.Position

	-- Find floor for crash effect
	if root then
		local params = RaycastParams.new()

		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {
			character
		}

		local result = workspace:Raycast(
			root.Position,
			Vector3.new(0, -10000, 0),
			params
		)

		if result then
			crashPosition = result.Position
		end
	end

	if flightVelocity then
		flightVelocity:Destroy()
		flightVelocity = nil
	end

	if flightOrientation then
		flightOrientation:Destroy()
		flightOrientation = nil
	end

	if flightAttachment then
		flightAttachment:Destroy()
		flightAttachment = nil
	end

	if humanoid then
		humanoid.AutoRotate = true
		humanoid.WalkSpeed = running and RUN_SPEED or 16
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	-- HUGE SKY CRASH
	if crashPosition then
		createCrash(crashPosition)
	end

	flyButton.Text = "HERO FLY: OFF"
	flyButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	status.Text = running
		and "NAOYA RUN • 190 SPEED"
		or "READY"
end


