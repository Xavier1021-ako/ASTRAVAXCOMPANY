local function addButton(parent,text,callback)
	local b=Instance.new("TextButton",parent)
	b.Size=UDim2.new(1,0,0,34)
	b.BackgroundColor3=BUTTON
	b.BorderSizePixel=0
	b.Text=text
	b.TextColor3=WHITE
	b.TextSize=11
	b.Font=Enum.Font.GothamMedium
	b.AutoButtonColor=false
	Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
	local stroke=Instance.new("UIStroke",b)
	stroke.Color=PURPLE
	stroke.Transparency=.65
	b.MouseEnter:Connect(function() TweenService:Create(stroke,TweenInfo.new(.15),{Transparency=.15}):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(stroke,TweenInfo.new(.15),{Transparency=.65}):Play() end)
	b.MouseButton1Click:Connect(function() if callback then callback(b) end end)
	return b
end

local speed=false
local noclip=false
