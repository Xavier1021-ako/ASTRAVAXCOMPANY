--==================================================
-- RUN
--==================================================

local function enableRun()

	if not humanoid then return end

	running = true

	humanoid.WalkSpeed = RUN_SPEED

	RunButton.Text = "NAOYA RUN: ON"
	RunButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)

	Status.Text = "NAOYA RUN • 190 SPEED"
	Status.TextColor3 = Color3.fromRGB(180, 140, 255)

	if runConnection then
		runConnection:Disconnect()
	end

	local last = 0

	runConnection = RunService.RenderStepped:Connect(function()

		if not running then return end

		if humanoid then
			humanoid.WalkSpeed = RUN_SPEED
		end

		Bar.Size = UDim2.fromScale(1, 1)

		local now = os.clock()

		if now - last >= AFTERIMAGE_RATE then
			last = now
			createAfterimage()
		end
	end)
end

local function disableRun()

	running = false

	if runConnection then
		runConnection:Disconnect()
		runConnection = nil
	end

	if humanoid and not flying then
		humanoid.WalkSpeed = 16
	end

	RunButton.Text = "NAOYA RUN: OFF"
	RunButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	Status.Text = "NAOYA RUN • OFF"
	Status.TextColor3 = Color3.fromRGB(145, 145, 165)
end

--==================================================
-- HERO FLY
--==================================================

local function enableFly()

	if not humanoid or not root then
		return
	end

	flying = true
	flightStart = os.clock()
	flightVelocity = Vector3.zero

	humanoid.AutoRotate = false

	FlyButton.Text = "HERO FLY: ON"
	FlyButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)

	Status.Text = "SUPERMAN FLIGHT • ON"
	Status.TextColor3 = Color3.fromRGB(180, 140, 255)

	if flyConnection then
		flyConnection:Disconnect()
	end

	flyConnection = RunService.RenderStepped:Connect(function(dt)

		if not flying or not root then
			return
		end

		local camera = workspace.CurrentCamera

		local move = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move += camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move -= camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move -= camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move += camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			move += Vector3.yAxis
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			move -= Vector3.yAxis
		end

		if move.Magnitude > 0 then
			move = move.Unit * FLY_SPEED
		end

		-- Smooth acceleration
		flightVelocity =
			flightVelocity:Lerp(
				move,
				math.clamp(dt * FLY_ACCELERATION, 0, 1)
			)

		root.AssemblyLinearVelocity = flightVelocity

		-- Face camera direction
		local look = camera.CFrame.LookVector

		if look.Magnitude > 0 then

			local t = os.clock() - flightStart

			local wobble =
				math.sin(t * 4) * math.rad(3)

			root.CFrame =
				CFrame.lookAt(
					root.Position,
					root.Position + look
				)
				* CFrame.Angles(
					math.rad(-8),
					0,
					wobble
				)
		end

		-- Superman pose
		applyHeroPose(
			move.Magnitude > 5,
			os.clock() - flightStart
		)

		-- Void flight trail
		if math.random() < 0.35 then

			createVoidParticle(
				root.Position
				- camera.CFrame.LookVector * 1.7
			)
		end
	end)
end

--==================================================
-- STOP FLY
--==================================================

local function disableFly()

	if not flying then return end

	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	local crashPosition

	if root then

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = {character}

		local result =
			workspace:Raycast(
				root.Position,
				Vector3.new(0, -1000, 0),
				params
			)

		if result then
			crashPosition =
				result.Position
				+ Vector3.new(0, 0.15, 0)
		else
			crashPosition = root.Position
		end

		root.AssemblyLinearVelocity = Vector3.zero
	end

	resetPose()

	if humanoid then
		humanoid.AutoRotate = true

		if running then
			humanoid.WalkSpeed = RUN_SPEED
		else
			humanoid.WalkSpeed = 16
		end
	end

	if crashPosition then
		crashExplosion(crashPosition)
	end

	FlyButton.Text = "HERO FLY: OFF"
	FlyButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	Status.Text =
		running
		and "NAOYA RUN • 190 SPEED"
		or "NAOYA RUN • OFF"
end

