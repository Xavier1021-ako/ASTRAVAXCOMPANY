end

--==================================================
-- BLACK HOLE DUST DEVIL
--==================================================

local function createDustDevil(position, parent)
	local folder = Instance.new("Folder")
	folder.Name = "VoidDustDevil"
	folder.Parent = parent

	-- Black hole
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.8, 0.8, 0.8)
	core.Position = position
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(5, 0, 15)
	core.Transparency = 0.15
	core.Parent = folder

	-- Glow
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(110, 45, 255)
	light.Brightness = 2
	light.Range = 7
	light.Parent = core

	-- Dust devil spiral
	for i = 1, 7 do
		local angle = (math.pi * 2 / 7) * i

		local ring = Instance.new("Part")
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(
			0.12,
			1.5 + i * 0.18,
			0.12
		)

		local radius = 0.4 + i * 0.12
		local height = (i - 4) * 0.35

		ring.CFrame =
			CFrame.new(
				position
				+ Vector3.new(
					math.cos(angle) * radius,
					height,
					math.sin(angle) * radius
				)
			)
			* CFrame.Angles(0, angle, math.rad(90))

		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false

		makeVoidPart(ring)

		ring.Parent = folder
	end

	-- Fade
	task.delay(0.05, function()
		for _, obj in ipairs(folder:GetDescendants()) do
			if obj:IsA("BasePart") then
				TweenService:Create(
					obj,
					TweenInfo.new(AFTERIMAGE_LIFETIME),
					{Transparency = 1}
				):Play()
			end
		end

		task.wait(AFTERIMAGE_LIFETIME)
		folder:Destroy()
	end)
end

--==================================================
-- AFTERIMAGE
--==================================================

local function createAfterimage()
	if not character or not root then
		return
	end

	local clone = character:Clone()
	clone.Name = "VoidAfterimage"

	for _, obj in ipairs(clone:GetDescendants()) do

		if obj:IsA("Script")
		or obj:IsA("LocalScript")
		or obj:IsA("ModuleScript") then
			obj:Destroy()

		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.Material = Enum.Material.Neon
			obj.Color = Color3.fromRGB(65, 20, 130)
			obj.Transparency = 0.55

		elseif obj:IsA("Decal") then
			obj.Transparency = 0.7
		end
	end

	clone.Parent = workspace

	local afterRoot = clone:FindFirstChild("HumanoidRootPart")

	if afterRoot then
		afterRoot.CFrame = root.CFrame

		createDustDevil(
			afterRoot.Position,
			workspace
		)
	end

	for _, obj in ipairs(clone:GetDescendants()) do
		if obj:IsA("BasePart") then
			TweenService:Create(
				obj,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	task.delay(AFTERIMAGE_LIFETIME, function()
		if clone then
			clone:Destroy()
		end
	end)
end

--==================================================
-- RUN SYSTEM
--==================================================

local effectConnection
local lastAfterimage = 0

local function enableRun()
	if not humanoid then
		return
	end

	running = true
	humanoid.WalkSpeed = SPEED

	toggle.Text = "NAOYA RUN: ON"
	toggle.BackgroundColor3 = Color3.fromRGB(75, 35, 150)

	if effectConnection then
		effectConnection:Disconnect()
	end

	effectConnection = RunService.RenderStepped:Connect(function()
		if not running then
			return
		end

		-- Infinite run bar
		bar.Size = UDim2.fromScale(1, 1)

		-- Keep speed at 100
		if humanoid then
			humanoid.WalkSpeed = SPEED
		end

		-- Only create effects while moving
		if humanoid.MoveDirection.Magnitude > 0.05 then
			local now = os.clock()

			if now - lastAfterimage >= AFTERIMAGE_INTERVAL then
				lastAfterimage = now
				createAfterimage()
			end
		end
	end)
end

local function disableRun()
	running = false

	if effectConnection then
		effectConnection:Disconnect()
		effectConnection = nil
	end

	if humanoid then
		humanoid.WalkSpeed = 16
	end

	toggle.Text = "NAOYA RUN: OFF"
	toggle.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
	bar.Size = UDim2.fromScale(1, 1)
end

toggle.MouseButton1Click:Connect(function()
	if running then
		disableRun()
	else
		enableRun()
	end
end)

