--========================================================
-- BUTTON STATE
--========================================================

local function setButtonState(button, active, text)
	button.Text = text
	button:SetAttribute("Active", active)

	TweenService:Create(
		button,
		TweenInfo.new(0.15),
		{
			BackgroundColor3 = active
				and Color3.fromRGB(70, 35, 120)
				or PANEL_2
		}
	):Play()
end

--========================================================
-- AFTERIMAGE
--========================================================

local function createAfterimage()
	if not effectsEnabled or not character then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "AstravexAfterimage"
	folder.Parent = workspace

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart")
			and object.Name ~= "HumanoidRootPart"
			and object.Transparency < 1 then

			local ghost = Instance.new("Part")

			ghost.Size = object.Size
			ghost.CFrame = object.CFrame
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanTouch = false
			ghost.CanQuery = false
			ghost.Material = Enum.Material.Neon
			ghost.Color = VOID_PURPLE
			ghost.Transparency = 0.5
			ghost.Parent = folder

			TweenService:Create(
				ghost,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{Transparency = 1}
			):Play()
		end
	end

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--========================================================
-- VOID DUST
--========================================================

local function createDustDevil(position)
	if not effectsEnabled then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "VoidDust"
	folder.Parent = workspace

	for i = 1, 14 do
		local angle = i / 14 * math.pi * 2
		local radius = 0.4 + i * 0.12

		local particle = Instance.new("Part")

		particle.Shape = Enum.PartType.Ball
		particle.Size = Vector3.new(0.18, 0.18, 0.18)
		particle.Position = position + Vector3.new(
			math.cos(angle) * radius,
			(i - 7) * 0.1,
			math.sin(angle) * radius
		)

		particle.Anchored = true
		particle.CanCollide = false
		particle.CanTouch = false
		particle.CanQuery = false
		particle.Material = Enum.Material.Neon
		particle.Color = VOID_PURPLE
		particle.Parent = folder

		TweenService:Create(
			particle,
			TweenInfo.new(0.7),
			{
				Transparency = 1,
				Size = Vector3.zero
			}
		):Play()
	end

	Debris:AddItem(folder, 0.8)
end

--========================================================
-- VOID CRASH
--========================================================

local function createCrash(position)
	if not effectsEnabled then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "VoidCrash"
	folder.Parent = workspace

	local core = Instance.new("Part")

	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(30, 30, 30)
	core.Position = position
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Color = VOID_PURPLE
	core.Transparency = 0.2
	core.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = VOID_BRIGHT
	light.Brightness = 80
	light.Range = 220
	light.Parent = core

	TweenService:Create(
		core,
		TweenInfo.new(1, Enum.EasingStyle.Exponential),
		{
			Size = Vector3.new(350, 350, 350),
			Transparency = 1
		}
	):Play()

	Debris:AddItem(folder, 2)
end

--========================================================
-- VOID EMPEROR
--========================================================

local function setRun(enabled)
	running = enabled

	if enabled then
		humanoid.WalkSpeed = RUN_SPEED

		setButtonState(
			runButton,
			true,
			"VoidEmperor • ACTIVE"
		)

		status.Text = "VOID EMPEROR // 190 SPEED"

		if runConnection then
			runConnection:Disconnect()
		end

		local lastEffect = 0

		runConnection = RunService.RenderStepped:Connect(function()
			if not running then
				return
			end

			if humanoid and not flying then
				humanoid.WalkSpeed = RUN_SPEED
			end

			if os.clock() - lastEffect >= AFTERIMAGE_INTERVAL then
				lastEffect = os.clock()

				createAfterimage()

				if root then
					createDustDevil(root.Position)
				end
			end
		end)
	else
		if runConnection then
			runConnection:Disconnect()
			runConnection = nil
		end

		if humanoid and not flying then
			humanoid.WalkSpeed = 16
		end

		setButtonState(
			runButton,
			false,
			"VoidEmperor"
		)

		status.Text = "SYSTEM READY"
	end
end

--========================================================
-- MOBILE JOYSTICK FREE FLIGHT
--========================================================

local function startFlight()
	if not root or not humanoid then
		return
	end

	flying = true

	humanoid.AutoRotate = false
	humanoid.PlatformStand = false

	flightAttachment = Instance.new("Attachment")
	flightAttachment.Name = "AstravexFlightAttachment"
	flightAttachment.Parent = root

	flightVelocity = Instance.new("LinearVelocity")
	flightVelocity.Name = "AstravexFlightVelocity"
	flightVelocity.Attachment0 = flightAttachment
	flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	flightVelocity.MaxForce = math.huge
	flightVelocity.VectorVelocity = Vector3.zero
	flightVelocity.Parent = root

	flightOrientation = Instance.new("AlignOrientation")
	flightOrientation.Name = "AstravexFlightOrientation"
	flightOrientation.Attachment0 = flightAttachment
	flightOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	flightOrientation.MaxTorque = math.huge
	flightOrientation.Responsiveness = 25
	flightOrientation.Parent = root

	setButtonState(
		flyButton,
		true,
		"Void Flight • ACTIVE"
	)

	status.Text = "VOID FLIGHT // JOYSTICK CONTROL"

	local currentVelocity = Vector3.zero

	flyConnection = RunService.RenderStepped:Connect(function(dt)
		if not flying or not root or not flightVelocity then
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		-- DEFAULT ROBLOX MOBILE JOYSTICK
		local moveDirection = humanoid.MoveDirection
		local direction = Vector3.zero

		if moveDirection.Magnitude > 0.01 then
			local cameraLook = camera.CFrame.LookVector
			local cameraRight = camera.CFrame.RightVector

			local flatForward = Vector3.new(
				cameraLook.X,
				0,
				cameraLook.Z
			)

			local flatRight = Vector3.new(
				cameraRight.X,
				0,
				cameraRight.Z
			)

			if flatForward.Magnitude > 0.01 then
				flatForward = flatForward.Unit
			end

			if flatRight.Magnitude > 0.01 then
				flatRight = flatRight.Unit
			end

			local forwardAmount = moveDirection:Dot(flatForward)
			local rightAmount = moveDirection:Dot(flatRight)

			direction =
				flatForward * forwardAmount
				+ flatRight * rightAmount

			direction += Vector3.new(
				0,
				cameraLook.Y * math.abs(forwardAmount),
				0
			)
		end

		if direction.Magnitude > 0.01 then
			direction = direction.Unit
		end

		local targetVelocity = direction * FLY_SPEED

		currentVelocity = currentVelocity:Lerp(
			targetVelocity,
			math.clamp(dt * 10, 0, 1)
		)

		flightVelocity.VectorVelocity = currentVelocity

		if direction.Magnitude > 0.01 then
			flightOrientation.CFrame = CFrame.lookAt(
				root.Position,
				root.Position + direction
			)
		end

		if effectsEnabled
			and direction.Magnitude > 0.01
			and math.random() < 0.25 then

			createAfterimage()
		end
	end)
end

--========================================================
-- STOP FLIGHT
--========================================================

local function stopFlight()
	if not flying then
		return
	end

	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if flightVelocity then
		flightVelocity:Destroy()
		flightVelocity = nil
	end

	if flightOrientation then
		flightOrientation:Destroy()
		flightOrientation = nil
	end

	if flightAttachment then
		flightAttachment:Destroy()
		flightAttachment = nil
	end

	if humanoid then
		humanoid.AutoRotate = true
		humanoid.WalkSpeed = running and RUN_SPEED or 16
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		createCrash(root.Position)
	end

	setButtonState(
		flyButton,
		false,
		"Void Flight"
	)

	status.Text = running
		and "VOID EMPEROR // 190 SPEED"
		or "SYSTEM READY"
end

--========================================================
-- EFFECTS
--========================================================

local function toggleEffects()
	effectsEnabled = not effectsEnabled

	if effectsEnabled then
		setButtonState(
			effectsButton,
			true,
			"Load Effects Of the Void • ON"
		)

		status.Text = "VOID EFFECTS // LOADED"
	else
		setButtonState(
			effectsButton,
			false,
			"Load Effects Of the Void"
		)

		status.Text = "VOID EFFECTS // DISABLED"
	end
end

