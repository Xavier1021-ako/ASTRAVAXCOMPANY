local titleDrag=false
local dragStart
local startPos
title.InputBegan:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
		titleDrag=true
		dragStart=input.Position
		startPos=M.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if titleDrag and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
		local delta=input.Position-dragStart
		M.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then titleDrag=false end
end)

local doubleClickTime=0
local doubleClickWindow=.35
title.InputBegan:Connect(function(input)
	if input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
	local now=os.clock()
	if now-doubleClickTime<=doubleClickWindow then
		if minimized then restore() else minimize() end
		doubleClickTime=0
	else
		doubleClickTime=now
	end
end)

