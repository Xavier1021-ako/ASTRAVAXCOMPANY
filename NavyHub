local AbilityReady = true

local function VoidAbility()
	if not AbilityReady or not Root then return end

	AbilityReady = false

	PlayAnimation("Ability", 0.8)

	Status.Text = "VOID ABILITY // CASTING"

	Burst(Root.Position, Vector3.new(75, 75, 75))
	Ring(Root.Position)
	Afterimage()

	task.delay(0.8, function()
		Status.Text = FLYING
			and "VOID FLIGHT // JOYSTICK CONTROL"
			or EMPEROR
				and "VOID EMPEROR // 190 SPEED"
				or "SYSTEM READY"
	end)

	task.delay(0.1, function()
		AbilityReady = true
	end)
end

