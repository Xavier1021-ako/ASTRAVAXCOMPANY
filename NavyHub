local function createVoidParticle(position)
	local p = Instance.new("Part")

	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.12, 0.12, 0.12)
	p.Position = position

	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false

	p.Material = Enum.Material.Neon
	p.Color = VOID_COLOR

	p.Parent = workspace

	TweenService:Create(
		p,
		TweenInfo.new(0.7),
		{
			Transparency = 1,
			Size = Vector3.new(0.01, 0.01, 0.01)
		}
	):Play()

	Debris:AddItem(p, 0.8)
end

--==================================================
-- DUST DEVIL
--==================================================

local function createDustDevil(position)
	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidDustDevil"
	folder.Parent = workspace

	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.65, 0.65, 0.65)
	core.Position = position

	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false

	core.Material = Enum.Material.Neon
	core.Color = DARK_VOID
	core.Parent = folder

	local glow = Instance.new("PointLight")
	glow.Color = VOID_COLOR
	glow.Brightness = 2
	glow.Range = 6
	glow.Parent = core

	for i = 1, 9 do

		local angle = (i / 9) * math.pi * 2
		local radius = 0.3 + i * 0.12
		local height = -0.8 + i * 0.22

		local swirl = Instance.new("Part")

		swirl.Shape = Enum.PartType.Ball
		swirl.Size = Vector3.new(0.17, 0.17, 0.17)

		swirl.Position =
			position + Vector3.new(
				math.cos(angle) * radius,
				height,
				math.sin(angle) * radius
			)

		swirl.Anchored = true
		swirl.CanCollide = false
		swirl.CanTouch = false
		swirl.CanQuery = false

		swirl.Material = Enum.Material.Neon
		swirl.Color = VOID_COLOR
		swirl.Parent = folder

		TweenService:Create(
			swirl,
			TweenInfo.new(AFTERIMAGE_LIFETIME),
			{
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()
	end

	TweenService:Create(
		core,
		TweenInfo.new(AFTERIMAGE_LIFETIME),
		{
			Transparency = 1,
			Size = Vector3.new(0.03, 0.03, 0.03)
		}
	):Play()

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--==================================================
-- AFTERIMAGE
--==================================================

local function createAfterimage()
	if not character or not root then return end

	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidAfterimage"
	folder.Parent = workspace

	for _, original in ipairs(character:GetDescendants()) do

		if original:IsA("BasePart")
			and original.Transparency < 1
			and original.Name ~= "HumanoidRootPart" then

			local copy = Instance.new("Part")

			copy.Size = original.Size
			copy.CFrame = original.CFrame

			copy.Anchored = true
			copy.CanCollide = false
			copy.CanTouch = false
			copy.CanQuery = false

			copy.Material = Enum.Material.Neon
			copy.Color = VOID_COLOR
			copy.Transparency = 0.5

			copy.Parent = folder

			TweenService:Create(
				copy,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	createDustDevil(
		root.Position + Vector3.new(0, 1.5, 0)
	)

	Debris:AddItem(
		folder,
		AFTERIMAGE_LIFETIME + 0.1
	)
end

