local function voidParticle(position, velocity)
	local p = Instance.new("Part")

	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.12, 0.12, 0.12)
	p.Position = position

	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false

	p.Material = Enum.Material.Neon
	p.Color = VOID_COLOR
	p.Transparency = 0.1

	p.Parent = workspace

	TweenService:Create(
		p,
		TweenInfo.new(0.7),
		{
			Position = position + velocity,
			Transparency = 1,
			Size = Vector3.new(0.01, 0.01, 0.01)
		}
	):Play()

	Debris:AddItem(p, 0.8)
end

--========================================================
-- SMALL VOID DUST DEVIL
--========================================================

local function dustDevil(position)
	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidDustDevil"
	folder.Parent = workspace

	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.6, 0.6, 0.6)
	core.Position = position
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Color = DARK_VOID
	core.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = VOID_COLOR
	light.Brightness = 2
	light.Range = 6
	light.Parent = core

	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local radius = 0.3 + i * 0.1
		local height = -0.7 + i * 0.2

		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.16, 0.16, 0.16)
		p.Position = position + Vector3.new(
			math.cos(angle) * radius,
			height,
			math.sin(angle) * radius
		)

		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Material = Enum.Material.Neon
		p.Color = VOID_COLOR
		p.Parent = folder

		TweenService:Create(
			p,
			TweenInfo.new(AFTERIMAGE_LIFETIME),
			{
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()
	end

	TweenService:Create(
		core,
		TweenInfo.new(AFTERIMAGE_LIFETIME),
		{
			Transparency = 1,
			Size = Vector3.new(0.02, 0.02, 0.02)
		}
	):Play()

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--========================================================
-- AFTERIMAGE
--========================================================

local function createAfterimage()
	if not Character or not Root then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidAfterimage"
	folder.Parent = workspace

	for _, original in ipairs(Character:GetDescendants()) do
		if original:IsA("BasePart")
			and original.Transparency < 1
			and original.Name ~= "HumanoidRootPart" then

			local copy = Instance.new("Part")

			copy.Size = original.Size
			copy.CFrame = original.CFrame
			copy.Anchored = true

			copy.CanCollide = false
			copy.CanTouch = false
			copy.CanQuery = false

			copy.Material = Enum.Material.Neon
			copy.Color = VOID_COLOR
			copy.Transparency = 0.5

			copy.Parent = folder

			TweenService:Create(
				copy,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	dustDevil(Root.Position + Vector3.new(0, 1.2, 0))

	Debris:AddItem(
		folder,
		AFTERIMAGE_LIFETIME + 0.1
	)
end

--========================================================
-- FIND MOTOR
--========================================================

local function findMotor(names)
	if not Character then
		return nil
	end

	for _, name in ipairs(names) do
		for _, obj in ipairs(Character:GetDescendants()) do
			if obj:IsA("Motor6D") and obj.Name == name then
				return obj
			end
		end
	end

	return nil
end

--========================================================
-- SUPERMAN POSE
--========================================================

local function heroPose(moving, time)
	if not Character then
		return
	end

	-- Works with R6 and common R15 joint names.
	local rootJoint = findMotor({"RootJoint", "Root"})

	local waist = findMotor({"Waist"})

	local leftShoulder = findMotor({
		"Left Shoulder",
		"LeftShoulder"
	})

	local rightShoulder = findMotor({
		"Right Shoulder",
		"RightShoulder"
	})

	local leftHip = findMotor({
		"Left Hip",
		"LeftHip"
	})

	local rightHip = findMotor({
		"Right Hip",
		"RightHip"
	})

	local wobble = math.sin(time * 3.5) * math.rad(3)

	if moving then
		--========================================
		-- SUPERMAN MOVING
		--========================================

		if rootJoint then
			rootJoint.Transform =
				CFrame.Angles(
					math.rad(-15),
					0,
					wobble
				)
		end

		if waist then
			waist.Transform =
				CFrame.Angles(
					math.rad(-10),
					0,
					-wobble
				)
		end

		if leftShoulder then
			leftShoulder.Transform =
				CFrame.Angles(
					math.rad(-75),
					0,
					math.rad(-12)
				)
		end

		if rightShoulder then
			rightShoulder.Transform =
				CFrame.Angles(
					math.rad(-75),
					0,
					math.rad(12)
				)
		end

		if leftHip then
			leftHip.Transform =
				CFrame.Angles(
					math.rad(30),
					0,
					math.rad(-4)
				)
		end

		if rightHip then
			rightHip.Transform =
				CFrame.Angles(
					math.rad(30),
					0,
					math.rad(4)
				)
		end

	else
		--========================================
		-- SUPERMAN HOVER IDLE
		-- LEFT FOOT SLIGHTLY RAISED
		--========================================

		if rootJoint then
			rootJoint.Transform =
				CFrame.Angles(
					math.rad(-7) + wobble,
					0,
					math.rad(2)
				)
		end

		if waist then
			waist.Transform =
				CFrame.Angles(
					math.rad(-5),
					0,
					0
				)
		end

		if leftShoulder then
			leftShoulder.Transform =
				CFrame.Angles(
					math.rad(-60),
					0,
					math.rad(-12)
				)
		end

		if rightShoulder then
			rightShoulder.Transform =
				CFrame.Angles(
					math.rad(-60),
					0,
					math.rad(12)
				)
		end

		-- Left leg raised slightly
		if leftHip then
			leftHip.Transform =
				CFrame.Angles(
					math.rad(15),
					0,
					math.rad(-5)
				)
		end

		-- Right leg lower
		if rightHip then
			rightHip.Transform =
				CFrame.Angles(
					math.rad(-5),
					0,
					math.rad(3)
				)
		end
	end
end

--========================================================
-- RESET POSE
