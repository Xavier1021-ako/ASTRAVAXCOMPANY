--==================================================
-- DRAGGABLE UI
--==================================================

local dragging = false
local dragStart
local startPosition

Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

--==================================================
-- VOID PARTICLE
--==================================================

local function createVoidParticle(position)
	local p = Instance.new("Part")

	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(0.12, 0.12, 0.12)
	p.Position = position

	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false

	p.Material = Enum.Material.Neon
	p.Color = VOID_COLOR
	p.Transparency = 0.1

	p.Parent = workspace

	TweenService:Create(
		p,
		TweenInfo.new(AFTERIMAGE_LIFETIME),
		{
			Transparency = 1,
			Size = Vector3.new(0.01, 0.01, 0.01)
		}
	):Play()

	Debris:AddItem(p, AFTERIMAGE_LIFETIME + 0.1)
end

--==================================================
-- SMALL BLACK-HOLE DUST DEVIL
--==================================================

local function createDustDevil(position)
	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidDustDevil"
	folder.Parent = workspace

	-- Black-hole center
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.65, 0.65, 0.65)
	core.Position = position

	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false

	core.Material = Enum.Material.Neon
	core.Color = DARK_VOID
	core.Parent = folder

	local glow = Instance.new("PointLight")
	glow.Color = VOID_COLOR
	glow.Brightness = 2
	glow.Range = 6
	glow.Parent = core

	-- Character-sized dust devil
	for i = 1, 9 do
		local angle = (i / 9) * math.pi * 2

		local radius = 0.3 + i * 0.12
		local height = -0.8 + i * 0.22

		local swirl = Instance.new("Part")
		swirl.Shape = Enum.PartType.Ball
		swirl.Size = Vector3.new(0.17, 0.17, 0.17)

		swirl.Position =
			position + Vector3.new(
				math.cos(angle) * radius,
				height,
				math.sin(angle) * radius
			)

		swirl.Anchored = true
		swirl.CanCollide = false
		swirl.CanTouch = false
		swirl.CanQuery = false

		swirl.Material = Enum.Material.Neon
		swirl.Color = VOID_COLOR
		swirl.Transparency = 0.15

		swirl.Parent = folder

		TweenService:Create(
			swirl,
			TweenInfo.new(AFTERIMAGE_LIFETIME),
			{
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()
	end

	TweenService:Create(
		core,
		TweenInfo.new(AFTERIMAGE_LIFETIME),
		{
			Transparency = 1,
			Size = Vector3.new(0.03, 0.03, 0.03)
		}
	):Play()

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--==================================================
-- AFTERIMAGE
--==================================================

local function createAfterimage()
	if not character or not root then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidAfterimage"
	folder.Parent = workspace

	for _, original in ipairs(character:GetDescendants()) do

		if original:IsA("BasePart")
			and original.Transparency < 1
			and original.Name ~= "HumanoidRootPart" then

			local copy = Instance.new("Part")

			copy.Name = "VoidAfterimagePart"
			copy.Size = original.Size
			copy.CFrame = original.CFrame

			copy.Anchored = true
			copy.CanCollide = false
			copy.CanTouch = false
			copy.CanQuery = false

			copy.Material = Enum.Material.Neon
			copy.Color = VOID_COLOR
			copy.Transparency = 0.5

			copy.Parent = folder

			TweenService:Create(
				copy,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	createDustDevil(
		root.Position + Vector3.new(0, 1.5, 0)
	)

	for i = 1, 4 do
		createVoidParticle(
			root.Position + Vector3.new(
				math.random(-15, 15) / 10,
				math.random(0, 25) / 10,
				math.random(-15, 15) / 10
			)
		)
	end

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--==================================================
-- CRASH EXPLOSION
--==================================================

local function crashExplosion(position)
	local folder = Instance.new("Folder")
	folder.Name = "NavyVoidCrash"
	folder.Parent = workspace

	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(1, 1, 1)
	core.Position = position
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Color = DARK_VOID
	core.Transparency = 0.1
	core.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = VOID_COLOR
	light.Brightness = 8
	light.Range = 18
	light.Parent = core

	-- Shockwave
	local shockwave = Instance.new("Part")
	shockwave.Shape = Enum.PartType.Cylinder
	shockwave.Size = Vector3.new(0.15, 2, 2)
	shockwave.CFrame =
		CFrame.new(position)
		* CFrame.Angles(0, 0, math.rad(90))

	shockwave.Anchored = true
	shockwave.CanCollide = false
	shockwave.CanTouch = false
	shockwave.CanQuery = false

	shockwave.Material = Enum.Material.Neon
	shockwave.Color = VOID_COLOR
	shockwave.Transparency = 0.15
	shockwave.Parent = folder

	TweenService:Create(
		core,
		TweenInfo.new(0.45),
		{
			Size = Vector3.new(5, 5, 5),
			Transparency = 1
		}
	):Play()

	TweenService:Create(
		shockwave,
		TweenInfo.new(0.55),
		{
			Size = Vector3.new(0.15, 14, 14),
			Transparency = 1
		}
	):Play()

	-- Explosion particles
	for i = 1, 25 do
		local angle = math.random() * math.pi * 2
		local height = math.random(-5, 8) / 10

		local particle = Instance.new("Part")
		particle.Shape = Enum.PartType.Ball
		particle.Size = Vector3.new(0.12, 0.12, 0.12)
		particle.Position =
			position + Vector3.new(
				math.cos(angle) * 0.5,
				height,
				math.sin(angle) * 0.5
			)

		particle.Anchored = true
		particle.CanCollide = false
		particle.CanTouch = false
		particle.CanQuery = false

		particle.Material = Enum.Material.Neon
		particle.Color = VOID_COLOR
		particle.Parent = folder

		local target =
			particle.Position
			+ Vector3.new(
				math.cos(angle) * math.random(3, 7),
				math.random(1, 5),
				math.sin(angle) * math.random(3, 7)
			)

		TweenService:Create(
			particle,
			TweenInfo.new(0.5),
			{
				Position = target,
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()
	end

	Debris:AddItem(folder, 0.8)
end

--==================================================
-- NAOYA RUN
--==================================================

local function enableRun()
	if not humanoid then
		return
	end

	running = true
	humanoid.WalkSpeed = RUN_SPEED

	RunButton.Text = "NAOYA RUN: ON"
	RunButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)

	Status.Text = "NAOYA RUN • 190 SPEED"
	Status.TextColor3 = Color3.fromRGB(180, 140, 255)

	if runConnection then
		runConnection:Disconnect()
	end

	lastAfterimage = 0

	runConnection = RunService.RenderStepped:Connect(function()
		if not running then
			return
		end

		if humanoid then
			humanoid.WalkSpeed = RUN_SPEED
		end

		-- Infinite
		Bar.Size = UDim2.fromScale(1, 1)

		-- Slower, smoother loop
		local now = os.clock()

		if now - lastAfterimage >= AFTERIMAGE_RATE then
			lastAfterimage = now
			createAfterimage()
		end
	end)
end

local function disableRun()
	running = false

	if runConnection then
		runConnection:Disconnect()
		runConnection = nil
	end

	if humanoid and not flying then
		humanoid.WalkSpeed = 16
	end

	RunButton.Text = "NAOYA RUN: OFF"
	RunButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	Status.Text = "NAOYA RUN • OFF"
	Status.TextColor3 = Color3.fromRGB(145, 145, 165)

	Bar.Size = UDim2.fromScale(1, 1)
end

--==================================================
-- HERO-STYLE FLY
--==================================================

local function enableFly()
	if not character or not humanoid or not root then
		return
	end

	flying = true

	FlyButton.Text = "HERO FLY: ON"
	FlyButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)

	Status.Text = "HERO FLIGHT • VOID MODE"
	Status.TextColor3 = Color3.fromRGB(180, 140, 255)

	humanoid.PlatformStand = true

	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "NavyHeroFlight"
	bodyVelocity.MaxForce = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = root

	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "NavyHeroFlightGyro"
	bodyGyro.MaxTorque = Vector3.new(
		math.huge,
		math.huge,
		math.huge
	)
	bodyGyro.P = 10000
	bodyGyro.D = 500
	bodyGyro.Parent = root

	if flyConnection then
		flyConnection:Disconnect()
	end

	local startTime = os.clock()

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying or not root then
			return
		end

		local camera = workspace.CurrentCamera

		local move = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			move += camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			move -= camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			move -= camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			move += camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			move += Vector3.yAxis
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			move -= Vector3.yAxis
		end

		if move.Magnitude > 0 then
			move = move.Unit * FLY_SPEED
		end

		bodyVelocity.Velocity = move

		-- Hero-style flying wobble
		local t = os.clock() - startTime

		local wobble =
			math.sin(t * FLY_WOBBLE_SPEED)
			* math.rad(FLY_WOBBLE_AMOUNT)

		local forward = camera.CFrame.LookVector

		bodyGyro.CFrame =
			CFrame.lookAt(
				root.Position,
				root.Position + forward
			)
			* CFrame.Angles(
				wobble * 0.35,
				0,
				wobble
			)

		-- Flight trail
		if math.random() < 0.25 then
			createVoidParticle(
				root.Position
				- camera.CFrame.LookVector * 1.5
			)
		end
	end)
end

--==================================================
-- DISABLE FLY + CRASH
--==================================================

local function disableFly()
	if not flying then
		return
	end

	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if root then
		-- Explosion at the landing/crash point
		local rayParams = RaycastParams.new()
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.FilterDescendantsInstances = {character}

		local result = workspace:Raycast(
			root.Position,
			Vector3.new(0, -1000, 0),
			rayParams
		)

		local crashPosition

		if result then
			crashPosition = result.Position + Vector3.new(0, 0.15, 0)
		else
			crashPosition = root.Position
		end

		crashExplosion(crashPosition)

		local velocity =
			root:FindFirstChild("NavyHeroFlight")

		local gyro =
			root:FindFirstChild("NavyHeroFlightGyro")

		if velocity then
			velocity:Destroy()
		end

		if gyro then
			gyro:Destroy()
		end
	end

	if humanoid then
		humanoid.PlatformStand = false

		if running then
			humanoid.WalkSpeed = RUN_SPEED
		else
			humanoid.WalkSpeed = 16
		end
	end

	FlyButton.Text = "HERO FLY: OFF"
	FlyButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	Status.Text = running
		and "NAOYA RUN • 190 SPEED"
		or "NAOYA RUN • OFF"
end

