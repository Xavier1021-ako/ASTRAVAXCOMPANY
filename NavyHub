--========================================================
-- BUTTON STATE
--========================================================

local function setButtonState(button, active, text)
	button.Text = text
	button:SetAttribute("Active", active)

	TweenService:Create(
		button,
		TweenInfo.new(0.15),
		{
			BackgroundColor3 = active
				and Color3.fromRGB(70, 35, 120)
				or PANEL_2
		}
	):Play()
end

--========================================================
-- AFTERIMAGE
--========================================================

local function createAfterimage()
	if not effectsEnabled or not character then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "AstravexAfterimage"
	folder.Parent = workspace

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart")
			and object.Name ~= "HumanoidRootPart"
			and object.Transparency < 1 then

			local ghost = Instance.new("Part")

			ghost.Size = object.Size
			ghost.CFrame = object.CFrame
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanTouch = false
			ghost.CanQuery = false
			ghost.Material = Enum.Material.Neon
			ghost.Color = VOID_PURPLE
			ghost.Transparency = 0.5
			ghost.Parent = folder

			TweenService:Create(
				ghost,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--========================================================
-- VOID DUST
--========================================================

local function createDustDevil(position)
	if not effectsEnabled then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "VoidDust"
	folder.Parent = workspace

	for i = 1, 14 do
		local angle = i / 14 * math.pi * 2
		local radius = 0.4 + i * 0.12

		local particle = Instance.new("Part")

		particle.Shape = Enum.PartType.Ball
		particle.Size = Vector3.new(0.18, 0.18, 0.18)

		particle.Position = position + Vector3.new(
			math.cos(angle) * radius,
			(i - 7) * 0.1,
			math.sin(angle) * radius
		)

		particle.Anchored = true
		particle.CanCollide = false
		particle.CanTouch = false
		particle.CanQuery = false
		particle.Material = Enum.Material.Neon
		particle.Color = VOID_PURPLE
		particle.Parent = folder

		TweenService:Create(
			particle,
			TweenInfo.new(0.7),
			{
				Transparency = 1,
				Size = Vector3.zero
			}
		):Play()
	end

	Debris:AddItem(folder, 0.8)
end

--========================================================
-- VOID CRASH
--========================================================

local function createCrash(position)
	if not effectsEnabled then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "VoidCrash"
	folder.Parent = workspace

	local core = Instance.new("Part")

	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(30, 30, 30)
	core.Position = position
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Color = VOID_PURPLE
	core.Transparency = 0.2
	core.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = VOID_BRIGHT
	light.Brightness = 80
	light.Range = 220
	light.Parent = core

	TweenService:Create(
		core,
		TweenInfo.new(1, Enum.EasingStyle.Exponential),
		{
			Size = Vector3.new(350, 350, 350),
			Transparency = 1
		}
	):Play()

	for i = 1, 70 do
		local shard = Instance.new("Part")
		local size = math.random(3, 9)

		shard.Shape = Enum.PartType.Ball
		shard.Size = Vector3.new(size, size, size)
		shard.Position = position
		shard.Anchored = true
		shard.CanCollide = false
		shard.CanTouch = false
		shard.CanQuery = false
		shard.Material = Enum.Material.Neon
		shard.Color = i % 2 == 0 and VOID_PURPLE or VOID_BRIGHT
		shard.Parent = folder

		local angle = math.random() * math.pi * 2
		local distance = math.random(80, 350)

		TweenService:Create(
			shard,
			TweenInfo.new(math.random(60, 120) / 100),
			{
				Position = position + Vector3.new(
					math.cos(angle) * distance,
					math.random(-40, 100),
					math.sin(angle) * distance
				),
				Transparency = 1
			}
		):Play()
	end

	Debris:AddItem(folder, 2)
end

--========================================================
-- VOID EMPEROR
--========================================================

local function setRun(enabled)
	running = enabled

	if enabled then
		humanoid.WalkSpeed = RUN_SPEED

		setButtonState(
			runButton,
			true,
			"VoidEmperor • ACTIVE"
		)

		status.Text = "VOID EMPEROR // 190 SPEED"

		if runConnection then
			runConnection:Disconnect()
		end

		local lastEffect = 0

		runConnection = RunService.RenderStepped:Connect(function()
			if not running then
				return
			end

			if humanoid and not flying then
				humanoid.WalkSpeed = RUN_SPEED
			end

			if os.clock() - lastEffect >= AFTERIMAGE_INTERVAL then
				lastEffect = os.clock()

				createAfterimage()

				if root then
					createDustDevil(root.Position)
				end
			end
		end)
	else
		if runConnection then
			runConnection:Disconnect()
			runConnection = nil
		end

		if humanoid and not flying then
			humanoid.WalkSpeed = 16
		end

		setButtonState(
			runButton,
			false,
			"VoidEmperor"
		)

		status.Text = "SYSTEM READY"
	end
end

