local function GetMotor(...)
	if not Character then return end

	for _,name in ipairs({...}) do
		local motor=Character:FindFirstChild(name,true)

		if motor and motor:IsA("Motor6D") then
			return motor
		end
	end
end

local Animation=nil
local AnimationTime=0

local function ResetAnimation()
	if not Character then return end

	for _,object in ipairs(Character:GetDescendants()) do
		if object:IsA("Motor6D") then
			object.Transform=CFrame.identity
		end
	end
end

local function FlightAnimation(t,moving)
	local right=GetMotor("Right Shoulder","RightShoulder")
	local left=GetMotor("Left Shoulder","LeftShoulder")
	local waist=GetMotor("Waist")

	if moving then
		if waist then
			waist.Transform=CFrame.Angles(math.rad(-18),0,0)
		end

		if right then
			right.Transform=CFrame.Angles(math.rad(-25),0,math.rad(18))
		end

		if left then
			left.Transform=CFrame.Angles(math.rad(-25),0,math.rad(-18))
		end
	else
		local hover=math.sin(t*3)*5

		if waist then
			waist.Transform=CFrame.Angles(math.rad(hover),0,0)
		end

		if right then
			right.Transform=CFrame.Angles(math.rad(hover),0,math.rad(12))
		end

		if left then
			left.Transform=CFrame.Angles(math.rad(hover),0,math.rad(-12))
		end
	end
end

local function SpeedAnimation(t)
	local right=GetMotor("Right Shoulder","RightShoulder")
	local left=GetMotor("Left Shoulder","LeftShoulder")
	local rh=GetMotor("Right Hip","RightHip")
	local lh=GetMotor("Left Hip","LeftHip")

	local a=math.sin(t*14)
	local b=math.sin(t*14+math.pi)

	if right then
		right.Transform=CFrame.Angles(math.rad(25*b),0,math.rad(8))
	end

	if left then
		left.Transform=CFrame.Angles(math.rad(25*a),0,math.rad(-8))
	end

	if rh then
		rh.Transform=CFrame.Angles(math.rad(28*a),0,0)
	end

	if lh then
		lh.Transform=CFrame.Angles(math.rad(28*b),0,0)
	end
end

local function AbilityAnimation(t)
	local right=GetMotor("Right Shoulder","RightShoulder")
	local left=GetMotor("Left Shoulder","LeftShoulder")
	local waist=GetMotor("Waist")

	local pulse=math.sin(t*18)

	if waist then
		waist.Transform=CFrame.Angles(math.rad(-8),0,0)
	end

	if right then
		right.Transform=CFrame.Angles(
			math.rad(-65+pulse*10),
			0,
			math.rad(30)
		)
	end

	if left then
		left.Transform=CFrame.Angles(
			math.rad(-65-pulse*10),
			0,
			math.rad(-30)
		)
	end
end

local function PlayAnimation(name,duration)
	Animation=name

	task.delay(duration,function()
		if Animation==name then
			Animation=nil
		end
	end)
end

RunService.RenderStepped:Connect(function(dt)
	AnimationTime+=dt

	if Animation=="Ability" then
		AbilityAnimation(AnimationTime)
	elseif Flying then
		FlightAnimation(
			AnimationTime,
			Humanoid.MoveDirection.Magnitude>.05
		)
	elseif Emperor then
		SpeedAnimation(AnimationTime)
	else
		ResetAnimation()
	end
end)

local function Burst(position,size)
	if not Effects then return end

	local part=Instance.new("Part")
	part.Shape=Enum.PartType.Ball
	part.Size=Vector3.new(3,3,3)
	part.Position=position
	part.Anchored=true
	part.CanCollide=false
	part.CanTouch=false
	part.CanQuery=false
	part.Material=Enum.Material.Neon
	part.Color=PURPLE
	part.Transparency=.2
	part.Parent=workspace

	TweenService:Create(
		part,
		TweenInfo.new(.7,Enum.EasingStyle.Exponential),
		{
			Size=size or Vector3.new(60,60,60),
			Transparency=1
		}
	):Play()

	Debris:AddItem(part,1)
end

local function Ring(position)
	if not Effects then return end

	local ring=Instance.new("Part")
	ring.Shape=Enum.PartType.Cylinder
	ring.Size=Vector3.new(.2,3,3)
	ring.CFrame=
		CFrame.new(position)*
		CFrame.Angles(0,0,math.rad(90))
	ring.Anchored=true
	ring.CanCollide=false
	ring.CanTouch=false
	ring.CanQuery=false
	ring.Material=Enum.Material.Neon
	ring.Color=BRIGHT
	ring.Transparency=.2
	ring.Parent=workspace

	TweenService:Create(
		ring,
		TweenInfo.new(.7,Enum.EasingStyle.Exponential),
		{
			Size=Vector3.new(.2,65,65),
			Transparency=1
		}
	):Play()

	Debris:AddItem(ring,1)
end

local function Afterimage()
	if not Effects or not Character then return end

	local folder=Instance.new("Folder")
	folder.Name="VoidAfterimage"
	folder.Parent=workspace

	for _,object in ipairs(Character:GetDescendants()) do
		if object:IsA("BasePart")
			and object.Name~="HumanoidRootPart"
			and object.Transparency<1 then

			local ghost=Instance.new("Part")
			ghost.Size=object.Size
			ghost.CFrame=object.CFrame
			ghost.Anchored=true
			ghost.CanCollide=false
			ghost.CanTouch=false
			ghost.CanQuery=false
			ghost.Material=Enum.Material.Neon
			ghost.Color=PURPLE
			ghost.Transparency=.55
			ghost.Parent=folder

			TweenService:Create(
				ghost,
				TweenInfo.new(.6),
				{Transparency=1}
			):Play()
		end
	end

	Debris:AddItem(folder,.8)
end

