--============================================================
-- CREATE FLIGHT
--============================================================

local function CreateFlightController()

	if FlightVelocity then
		FlightVelocity:Destroy()
	end

	if FlightOrientation then
		FlightOrientation:Destroy()
	end

	FlightAttachment = Instance.new("Attachment")

	FlightAttachment.Name =
		"NavyFlightAttachment"

	FlightAttachment.Parent = Root

	-- FREE 3D MOVEMENT
	FlightVelocity = Instance.new("LinearVelocity")

	FlightVelocity.Name =
		"NavyFlightVelocity"

	FlightVelocity.Attachment0 =
		FlightAttachment

	FlightVelocity.RelativeTo =
		Enum.ActuatorRelativeTo.World

	FlightVelocity.MaxForce =
		math.huge

	FlightVelocity.VectorVelocity =
		Vector3.zero

	FlightVelocity.Parent = Root

	-- CHARACTER ROTATION
	FlightOrientation =
		Instance.new("AlignOrientation")

	FlightOrientation.Name =
		"NavyFlightOrientation"

	FlightOrientation.Attachment0 =
		FlightAttachment

	FlightOrientation.Mode =
		Enum.OrientationAlignmentMode.OneAttachment

	FlightOrientation.MaxTorque =
		math.huge

	FlightOrientation.MaxAngularVelocity =
		math.huge

	FlightOrientation.Responsiveness =
		35

	FlightOrientation.Parent = Root

end

--============================================================
-- ENABLE RUN
--============================================================

local function EnableRun()

	Running = true

	Humanoid.WalkSpeed =
		RUN_SPEED

	RunButton.Text =
		"NAOYA RUN: ON"

	RunButton.BackgroundColor3 =
		Color3.fromRGB(80, 35, 160)

	Status.Text =
		"NAOYA RUN • 190 SPEED"

	if RunConnection then
		RunConnection:Disconnect()
	end

	local LastAfterimage = 0

	RunConnection =
		RunService.RenderStepped:Connect(function()

			if not Running then
				return
			end

			if Humanoid and not Flying then
				Humanoid.WalkSpeed =
					RUN_SPEED
			end

			Bar.Size =
				UDim2.fromScale(1, 1)

			if os.clock() - LastAfterimage
				>= AFTERIMAGE_INTERVAL then

				LastAfterimage =
					os.clock()

				CreateAfterimage()

			end

		end)

end

--============================================================
-- DISABLE RUN
--============================================================

local function DisableRun()

	Running = false

	if RunConnection then

		RunConnection:Disconnect()
		RunConnection = nil

	end

	if Humanoid and not Flying then
		Humanoid.WalkSpeed = 16
	end

	RunButton.Text =
		"NAOYA RUN: OFF"

	RunButton.BackgroundColor3 =
		Color3.fromRGB(35, 35, 55)

	Status.Text =
		"READY"

end

