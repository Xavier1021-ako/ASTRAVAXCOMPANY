local function CreateVoidParticle(position, velocity)

	local Particle = Instance.new("Part")

	Particle.Shape = Enum.PartType.Ball
	Particle.Size = Vector3.new(0.12, 0.12, 0.12)

	Particle.Position = position

	Particle.Anchored = true
	Particle.CanCollide = false
	Particle.CanTouch = false
	Particle.CanQuery = false

	Particle.Material = Enum.Material.Neon
	Particle.Color = VOID

	Particle.Parent = workspace

	TweenService:Create(
		Particle,
		TweenInfo.new(0.7),
		{
			Position = position + velocity,
			Transparency = 1,
			Size = Vector3.new(0.01, 0.01, 0.01)
		}
	):Play()

	Debris:AddItem(Particle, 0.8)

end

--============================================================
-- SMALL VOID DUST DEVIL
--============================================================

local function CreateDustDevil(position)

	local Folder = Instance.new("Folder")

	Folder.Name = "NavyVoidDustDevil"
	Folder.Parent = workspace

	for i = 1, 12 do

		local Angle = (i / 12) * math.pi * 2
		local Radius = 0.3 + i * 0.1

		local Particle = Instance.new("Part")

		Particle.Shape = Enum.PartType.Ball
		Particle.Size = Vector3.new(0.16, 0.16, 0.16)

		Particle.Position =
			position
			+ Vector3.new(
				math.cos(Angle) * Radius,
				(i - 6) * 0.13,
				math.sin(Angle) * Radius
			)

		Particle.Anchored = true
		Particle.CanCollide = false
		Particle.CanTouch = false
		Particle.CanQuery = false

		Particle.Material = Enum.Material.Neon
		Particle.Color = VOID

		Particle.Parent = Folder

		TweenService:Create(
			Particle,
			TweenInfo.new(AFTERIMAGE_LIFETIME),
			{
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()

	end

	Debris:AddItem(
		Folder,
		AFTERIMAGE_LIFETIME + 0.1
	)

end

--============================================================
-- AFTERIMAGE
--============================================================

local function CreateAfterimage()

	if not Character or not Root then
		return
	end

	local Folder = Instance.new("Folder")

	Folder.Name = "NavyVoidAfterimage"
	Folder.Parent = workspace

	for _, Part in ipairs(Character:GetDescendants()) do

		if Part:IsA("BasePart")
			and Part.Transparency < 1
			and Part.Name ~= "HumanoidRootPart" then

			local Ghost = Instance.new("Part")

			Ghost.Size = Part.Size
			Ghost.CFrame = Part.CFrame

			Ghost.Anchored = true

			Ghost.CanCollide = false
			Ghost.CanTouch = false
			Ghost.CanQuery = false

			Ghost.Material = Enum.Material.Neon
			Ghost.Color = VOID
			Ghost.Transparency = 0.45

			Ghost.Parent = Folder

			TweenService:Create(
				Ghost,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()

		end

	end

	CreateDustDevil(
		Root.Position
	)

	Debris:AddItem(
		Folder,
		AFTERIMAGE_LIFETIME + 0.1
	)

end

--============================================================
-- MOTOR FINDER
--============================================================

local function FindMotor(names)

	if not Character then
		return nil
	end

	for _, name in ipairs(names) do

		for _, object in ipairs(Character:GetDescendants()) do

			if object:IsA("Motor6D")
				and object.Name == name then

				return object
			end

		end

	end

	return nil
end

--============================================================
-- SUPERMAN ANIMATION
--============================================================

local function SupermanPose(moving)

	if not Character then
		return
	end

	local Time = os.clock()

	local RootJoint =
		FindMotor({"RootJoint", "Root"})

	local Waist =
		FindMotor({"Waist"})

	local LeftShoulder =
		FindMotor({
			"Left Shoulder",
			"LeftShoulder"
		})

	local RightShoulder =
		FindMotor({
			"Right Shoulder",
			"RightShoulder"
		})

	local LeftHip =
		FindMotor({
			"Left Hip",
			"LeftHip"
		})

	local RightHip =
		FindMotor({
			"Right Hip",
			"RightHip"
		})

	local Wobble =
		math.sin(Time * 3.2) * math.rad(3)

	if moving then

		-- BODY
		if RootJoint then

			RootJoint.Transform =
				CFrame.Angles(
					math.rad(-18),
					0,
					Wobble
				)

		end

		if Waist then

			Waist.Transform =
				CFrame.Angles(
					math.rad(-12),
					0,
					-Wobble
				)

		end

		-- ARMS FORWARD
		if LeftShoulder then

			LeftShoulder.Transform =
				CFrame.Angles(
					math.rad(-75),
					0,
					math.rad(-10)
				)

		end

		if RightShoulder then

			RightShoulder.Transform =
				CFrame.Angles(
					math.rad(-75),
					0,
					math.rad(10)
				)

		end

		-- LEGS BACK
		if LeftHip then

			LeftHip.Transform =
				CFrame.Angles(
					math.rad(35),
					0,
					math.rad(-4)
				)

		end

		if RightHip then

			RightHip.Transform =
				CFrame.Angles(
					math.rad(35),
					0,
					math.rad(4)
				)

		end

	else

		-- HOVER IDLE

		if RootJoint then

			RootJoint.Transform =
				CFrame.Angles(
					math.rad(-8) + Wobble,
					0,
					math.rad(2)
				)

		end

		if Waist then

			Waist.Transform =
				CFrame.Angles(
					math.rad(-5),
					0,
					0
				)

		end

		-- ARMS
		if LeftShoulder then

			LeftShoulder.Transform =
				CFrame.Angles(
					math.rad(-60),
					0,
					math.rad(-12)
				)

		end

		if RightShoulder then

			RightShoulder.Transform =
				CFrame.Angles(
					math.rad(-60),
					0,
					math.rad(12)
				)

		end

		-- LEFT FOOT SLIGHTLY UP
		if LeftHip then

			LeftHip.Transform =
				CFrame.Angles(
					math.rad(18),
					0,
					math.rad(-6)
				)

		end

		if RightHip then

			RightHip.Transform =
				CFrame.Angles(
					math.rad(-6),
					0,
					math.rad(3)
				)

		end

	end

end

--============================================================
-- RESET POSE
--============================================================

local function ResetPose()

	for Motor, Transform in pairs(OriginalMotors) do

		if Motor and Motor.Parent then
			Motor.Transform = Transform
		end

	end

end

