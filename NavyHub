local function setFlight(on)
	flying=on
	destroyFlightObjects()
	if not on or not root then
		if hum then hum.PlatformStand=false;hum.WalkSpeed=speed and RUN_SPEED or DEFAULT_SPEED end
		return
	end
	if hum then hum.PlatformStand=true end
	flightVelocity=Instance.new("BodyVelocity")
	flightVelocity.Name="NavyHubFlightVelocity"
	flightVelocity.MaxForce=Vector3.new(1e6,1e6,1e6)
	flightVelocity.Velocity=Vector3.zero
	flightVelocity.Parent=root
	flightGyro=Instance.new("BodyGyro")
	flightGyro.Name="NavyHubFlightGyro"
	flightGyro.MaxTorque=Vector3.new(1e6,1e6,1e6)
	flightGyro.P=50000
	flightGyro.CFrame=root.CFrame
	flightGyro.Parent=root
end

addButton(movement,"Void Flight: OFF",function(b)
