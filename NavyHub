--========================================================
-- DRAGGABLE UI
--========================================================

local dragging = false
local dragStart = nil
local startPosition = nil

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position
	end
end)

main.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

--========================================================
-- AFTERIMAGE
--========================================================

local function createAfterimage()
	if not character then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "NavyAfterimage"
	folder.Parent = workspace

	for _, object in ipairs(character:GetDescendants()) do
		if object:IsA("BasePart")
			and object.Name ~= "HumanoidRootPart"
			and object.Transparency < 1 then

			local ghost = Instance.new("Part")

			ghost.Name = "VoidAfterimage"
			ghost.Size = object.Size
			ghost.CFrame = object.CFrame

			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanTouch = false
			ghost.CanQuery = false

			ghost.Material = Enum.Material.Neon
			ghost.Color = VOID
			ghost.Transparency = 0.45

			ghost.Parent = folder

			local tween = TweenService:Create(
				ghost,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			)

			tween:Play()
		end
	end

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--========================================================
-- DUST DEVIL
--========================================================

local function createDustDevil(position)
	local folder = Instance.new("Folder")
	folder.Name = "VoidDustDevil"
	folder.Parent = workspace

	for i = 1, 12 do
		local angle = (i / 12) * math.pi * 2
		local radius = 0.25 + i * 0.12

		local p = Instance.new("Part")

		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(0.16, 0.16, 0.16)

		p.Position = position + Vector3.new(
			math.cos(angle) * radius,
			(i - 6) * 0.12,
			math.sin(angle) * radius
		)

		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false

		p.Material = Enum.Material.Neon
		p.Color = VOID
		p.Parent = folder

		TweenService:Create(
			p,
			TweenInfo.new(AFTERIMAGE_LIFETIME),
			{
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()
	end

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--========================================================
-- HUGE CRASH
--========================================================

local function skyCrash(position)
	local folder = Instance.new("Folder")
	folder.Name = "NavySkyCrash"
	folder.Parent = workspace

	-- 100x giant core
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(100, 100, 100)
	core.Position = position

	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false

	core.Material = Enum.Material.Neon
	core.Color = DARK_VOID
	core.Transparency = 0.1
	core.Parent = folder

	local light = Instance.new("PointLight")
	light.Color = VOID_BRIGHT
	light.Brightness = 100
	light.Range = 250
	light.Parent = core

	TweenService:Create(
		core,
		TweenInfo.new(
			1.2,
			Enum.EasingStyle.Exponential,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(500, 500, 500),
			Transparency = 1
		}
	):Play()

	-- shockwave
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(2, 100, 100)

	ring.CFrame =
		CFrame.new(position)
		* CFrame.Angles(0, 0, math.rad(90))

	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false

	ring.Material = Enum.Material.Neon
	ring.Color = VOID_BRIGHT
	ring.Transparency = 0.1
	ring.Parent = folder

	TweenService:Create(
		ring,
		TweenInfo.new(
			1.4,
			Enum.EasingStyle.Exponential,
			Enum.EasingDirection.Out
		),
		{
			Size = Vector3.new(2, 1200, 1200),
			Transparency = 1
		}
	):Play()

	-- second ring
	task.delay(0.12, function()
		if not folder.Parent then
			return
		end

		local ring2 = Instance.new("Part")

		ring2.Shape = Enum.PartType.Cylinder
		ring2.Size = Vector3.new(3, 60, 60)

		ring2.CFrame =
			CFrame.new(position)
			* CFrame.Angles(0, 0, math.rad(90))

		ring2.Anchored = true
		ring2.CanCollide = false
		ring2.CanTouch = false
		ring2.CanQuery = false

		ring2.Material = Enum.Material.Neon
		ring2.Color = VOID_BRIGHT
		ring2.Transparency = 0.05
		ring2.Parent = folder

		TweenService:Create(
			ring2,
			TweenInfo.new(1.8),
			{
				Size = Vector3.new(3, 1800, 1800),
				Transparency = 1
			}
		):Play()

		Debris:AddItem(ring2, 2)
	end)

	-- giant particles
	for i = 1, 150 do
		local particle = Instance.new("Part")

		particle.Shape = Enum.PartType.Ball

		local size = math.random(5, 15)

		particle.Size = Vector3.new(size, size, size)
		particle.Position = position

		particle.Anchored = true
		particle.CanCollide = false
		particle.CanTouch = false
		particle.CanQuery = false

		particle.Material = Enum.Material.Neon

		if i % 3 == 0 then
			particle.Color = VOID_BRIGHT
		else
			particle.Color = VOID
		end

		particle.Parent = folder

		local angle = math.random() * math.pi * 2
		local distance = math.random(100, 500)
		local height = math.random(-60, 120)

		local destination = position + Vector3.new(
			math.cos(angle) * distance,
			height,
			math.sin(angle) * distance
		)

		TweenService:Create(
			particle,
			TweenInfo.new(
				math.random(70, 130) / 100,
				Enum.EasingStyle.Exponential,
				Enum.EasingDirection.Out
			),
			{
				Position = destination,
				Transparency = 1,
				Size = Vector3.new(1, 1, 1)
			}
		):Play()
	end

	task.spawn(function()
		for _ = 1, 8 do
			if light.Parent then
				light.Brightness = 150
				task.wait(0.04)

				light.Brightness = 25
				task.wait(0.04)
			end
		end
	end)

	Debris:AddItem(folder, 2.5)
end

--========================================================
-- FLIGHT
--========================================================

local function createFlight()
	if not root then
		return false
	end

	if flightVelocity then
		flightVelocity:Destroy()
		flightVelocity = nil
	end

	if flightOrientation then
		flightOrientation:Destroy()
		flightOrientation = nil
	end

	if flightAttachment then
		flightAttachment:Destroy()
		flightAttachment = nil
	end

	flightAttachment = Instance.new("Attachment")
	flightAttachment.Name = "NavyFlightAttachment"
	flightAttachment.Parent = root

	flightVelocity = Instance.new("LinearVelocity")
	flightVelocity.Name = "NavyFlightVelocity"
	flightVelocity.Attachment0 = flightAttachment
	flightVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	flightVelocity.MaxForce = math.huge
	flightVelocity.VectorVelocity = Vector3.zero
	flightVelocity.Parent = root

	flightOrientation = Instance.new("AlignOrientation")
	flightOrientation.Name = "NavyFlightOrientation"
	flightOrientation.Attachment0 = flightAttachment
	flightOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	flightOrientation.MaxTorque = math.huge
	flightOrientation.MaxAngularVelocity = math.huge
	flightOrientation.Responsiveness = 35
	flightOrientation.Parent = root

	return true
end

--========================================================
-- FLIGHT POSE
--========================================================

local function setFlightPose(moving)
	if not character then
		return
	end

	local torso = character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")

	if not torso then
		return
	end

	local time = os.clock()
	local wobble = math.sin(time * 3) * math.rad(3)

	local function findMotor(name)
		return torso:FindFirstChild(name)
			or character:FindFirstChild(name, true)
	end

	local leftShoulder =
		findMotor("Left Shoulder")
		or findMotor("LeftShoulder")

	local rightShoulder =
		findMotor("Right Shoulder")
		or findMotor("RightShoulder")

	local leftHip =
		findMotor("Left Hip")
		or findMotor("LeftHip")

	local rightHip =
		findMotor("Right Hip")
		or findMotor("RightHip")

	if leftShoulder then
		leftShoulder.Transform =
			CFrame.Angles(
				math.rad(moving and -75 or -60),
				0,
				math.rad(-10) + wobble
			)
	end

	if rightShoulder then
		rightShoulder.Transform =
			CFrame.Angles(
				math.rad(moving and -75 or -60),
				0,
				math.rad(10) - wobble
			)
	end

	if leftHip then
		leftHip.Transform =
			CFrame.Angles(
				math.rad(moving and 35 or 18),
				0,
				math.rad(-5)
			)
	end

	if rightHip then
		rightHip.Transform =
			CFrame.Angles(
				math.rad(moving and 35 or -6),
				0,
				math.rad(4)
			)
	end
end

--========================================================
-- RUN
--========================================================

local function enableRun()
	if not humanoid then
		return
	end

	running = true
	humanoid.WalkSpeed = RUN_SPEED

	runButton.Text = "NAOYA RUN: ON"
	runButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)
	status.Text = "NAOYA RUN • 190 SPEED"

	if runConnection then
		runConnection:Disconnect()
	end

	local lastAfterimage = 0

	runConnection = RunService.RenderStepped:Connect(function()
		if not running then
			return
		end

		if humanoid and not flying then
			humanoid.WalkSpeed = RUN_SPEED
		end

		bar.Size = UDim2.fromScale(1, 1)

		if os.clock() - lastAfterimage >= AFTERIMAGE_INTERVAL then
			lastAfterimage = os.clock()

			createAfterimage()

			if root then
				createDustDevil(root.Position)
			end
		end
	end)
end

local function disableRun()
	running = false

	if runConnection then
		runConnection:Disconnect()
		runConnection = nil
	end

	if humanoid and not flying then
		humanoid.WalkSpeed = 16
	end

	runButton.Text = "NAOYA RUN: OFF"
	runButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
	status.Text = "READY"
end

--========================================================
-- FLY ON
--========================================================

local function enableFly()
	if not humanoid or not root then
		getCharacter()
	end

	if not humanoid or not root then
		return
	end

	if not createFlight() then
		return
	end

	flying = true

	humanoid.AutoRotate = false
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	flyButton.Text = "HERO FLY: ON"
	flyButton.BackgroundColor3 = Color3.fromRGB(80, 35, 160)
	status.Text = "SUPERMAN FLIGHT • ON"

	if flyConnection then
		flyConnection:Disconnect()
	end

	local currentVelocity = Vector3.zero

	flyConnection = RunService.RenderStepped:Connect(function(dt)
		if not flying then
			return
		end

		if not character or not humanoid or not root then
			return
		end

		if not flightVelocity or not flightOrientation then
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local direction = Vector3.zero

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			direction += camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			direction -= camera.CFrame.LookVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			direction -= camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			direction += camera.CFrame.RightVector
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direction += Vector3.yAxis
		end

		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direction -= Vector3.yAxis
		end

		local targetVelocity = Vector3.zero

		if direction.Magnitude > 0.01 then
			targetVelocity = direction.Unit * FLY_SPEED
		end

		currentVelocity = currentVelocity:Lerp(
			targetVelocity,
			math.clamp(dt * 9, 0, 1)
		)

		flightVelocity.VectorVelocity = currentVelocity

		local lookDirection

		if direction.Magnitude > 0.01 then
			lookDirection = direction.Unit
		else
			lookDirection = camera.CFrame.LookVector
		end

		flightOrientation.CFrame =
			CFrame.lookAt(
				root.Position,
				root.Position + lookDirection
			)

		setFlightPose(direction.Magnitude > 0.01)

		if direction.Magnitude > 0.01 and math.random() < 0.4 then
			createDustDevil(root.Position - lookDirection * 2)
		end
	end)
end

--========================================================
-- FLY OFF + CRASH
--========================================================

local function disableFly()
	if not flying then
		return
	end

	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if not root then
		getCharacter()
	end

	if not root then
		return
	end

	-- Find ground
	local crashPosition = root.Position

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	local result = workspace:Raycast(
		root.Position,
		Vector3.new(0, -10000, 0),
		params
	)

	if result then
		crashPosition = result.Position
	end

	-- Remove flight objects
	if flightVelocity then
		flightVelocity:Destroy()
		flightVelocity = nil
	end

	if flightOrientation then
		flightOrientation:Destroy()
		flightOrientation = nil
	end

	if flightAttachment then
		flightAttachment:Destroy()
		flightAttachment = nil
	end

	root.AssemblyLinearVelocity = Vector3.zero

	humanoid.AutoRotate = true
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

	if running then
		humanoid.WalkSpeed = RUN_SPEED
	else
		humanoid.WalkSpeed = 16
	end

	-- MASSIVE CRASH
	skyCrash(crashPosition)

	flyButton.Text = "HERO FLY: OFF"
	flyButton.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	status.Text =
		running
		and "NAOYA RUN • 190 SPEED"
		or "READY"
end

