--==================================================
-- DRAGGABLE UI
--==================================================

local dragging = false
local dragStart
local startPosition

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

--==================================================
-- VOID DUST DEVIL
--==================================================

local function createDustDevil(position)
	local folder = Instance.new("Folder")
	folder.Name = "VoidDustDevil"
	folder.Parent = workspace

	-- Black hole
	local core = Instance.new("Part")
	core.Shape = Enum.PartType.Ball
	core.Size = Vector3.new(0.65, 0.65, 0.65)
	core.Position = position
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Color = BLACK_HOLE_COLOR
	core.Parent = folder

	local glow = Instance.new("PointLight")
	glow.Color = VOID_COLOR
	glow.Brightness = 2
	glow.Range = 6
	glow.Parent = core

	-- Small dust-devil spiral
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local radius = 0.35 + i * 0.12
		local height = -0.8 + i * 0.23

		local swirl = Instance.new("Part")
		swirl.Shape = Enum.PartType.Ball
		swirl.Size = Vector3.new(0.18, 0.18, 0.18)

		swirl.Position =
			position + Vector3.new(
				math.cos(angle) * radius,
				height,
				math.sin(angle) * radius
			)

		swirl.Anchored = true
		swirl.CanCollide = false
		swirl.CanTouch = false
		swirl.CanQuery = false
		swirl.Material = Enum.Material.Neon
		swirl.Color = VOID_COLOR
		swirl.Transparency = 0.15
		swirl.Parent = folder

		TweenService:Create(
			swirl,
			TweenInfo.new(AFTERIMAGE_LIFETIME),
			{
				Transparency = 1,
				Size = Vector3.new(0.01, 0.01, 0.01)
			}
		):Play()
	end

	TweenService:Create(
		core,
		TweenInfo.new(AFTERIMAGE_LIFETIME),
		{
			Transparency = 1,
			Size = Vector3.new(0.05, 0.05, 0.05)
		}
	):Play()

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--==================================================
-- VOID AFTERIMAGE
--==================================================

local function createAfterimage()
	if not character or not root then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "VoidAfterimage"
	folder.Parent = workspace

	for _, original in ipairs(character:GetDescendants()) do
		if original:IsA("BasePart")
			and original.Transparency < 1
			and original.Name ~= "HumanoidRootPart" then

			local copy = Instance.new("Part")

			copy.Name = "VoidBody"
			copy.Size = original.Size
			copy.CFrame = original.CFrame
			copy.Anchored = true
			copy.CanCollide = false
			copy.CanTouch = false
			copy.CanQuery = false
			copy.Material = Enum.Material.Neon
			copy.Color = VOID_COLOR
			copy.Transparency = 0.5
			copy.Parent = folder

			TweenService:Create(
				copy,
				TweenInfo.new(AFTERIMAGE_LIFETIME),
				{
					Transparency = 1
				}
			):Play()
		end
	end

	-- Small black-hole dust devil around every afterimage
	createDustDevil(
		root.Position + Vector3.new(0, 1.5, 0)
	)

	Debris:AddItem(folder, AFTERIMAGE_LIFETIME + 0.1)
end

--==================================================
-- RUN LOOP
--==================================================

local function enableRun()
	if not humanoid then
		return
	end

	running = true
	humanoid.WalkSpeed = SPEED

	toggle.Text = "NAOYA RUN: ON"
	toggle.BackgroundColor3 = Color3.fromRGB(80, 35, 160)

	status.Text = "NAOYA RUN • 100 SPEED"
	status.TextColor3 = Color3.fromRGB(180, 140, 255)

	if runConnection then
		runConnection:Disconnect()
	end

	local lastAfterimage = 0

	runConnection = RunService.RenderStepped:Connect(function()
		if not running then
			return
		end

		-- Speed stays at 100
		if humanoid then
			humanoid.WalkSpeed = SPEED
		end

		-- Infinite bar
		bar.Size = UDim2.fromScale(1, 1)

		-- LOOP FOREVER WHILE ON
		local now = os.clock()

		if now - lastAfterimage >= AFTERIMAGE_RATE then
			lastAfterimage = now
			createAfterimage()
		end
	end)
end

--==================================================
-- STOP
--==================================================

local function disableRun()
	running = false

	if runConnection then
		runConnection:Disconnect()
		runConnection = nil
	end

	if humanoid then
		humanoid.WalkSpeed = 16
	end

	toggle.Text = "NAOYA RUN: OFF"
	toggle.BackgroundColor3 = Color3.fromRGB(35, 35, 55)

	status.Text = "NAOYA RUN • OFF"
	status.TextColor3 = Color3.fromRGB(150, 150, 170)

	bar.Size = UDim2.fromScale(1, 1)
end

--==================================================
-- BUTTON
--==================================================

toggle.MouseButton1Click:Connect(function()
	if running then
		disableRun()
	else
		enableRun()
	end
end)

