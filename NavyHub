--==================================================
-- DRAG UI
--==================================================

local dragging = false
local dragStart
local startPosition

Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		local delta = input.Position - dragStart

		Main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

--==================================================
-- HERO POSE
--==================================================

local function findMotor(name)
	if not character then return nil end

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Motor6D") and obj.Name == name then
			return obj
		end
	end

	return nil
end

local function applyHeroPose(moving, t)
	if not character then return end

	local rootJoint = findMotor("RootJoint")
	local waist = findMotor("Waist")

	local leftShoulder = findMotor("LeftShoulder")
	local rightShoulder = findMotor("RightShoulder")

	local leftHip = findMotor("LeftHip")
	local rightHip = findMotor("RightHip")

	local leftArm = findMotor("LeftShoulder")
	local rightArm = findMotor("RightShoulder")

	local wobble = math.sin(t * 4) * math.rad(3)

	-- Superman flying:
	-- arms forward, legs behind, body tilted

	if moving then

		if rootJoint then
			rootJoint.Transform =
				CFrame.Angles(
					math.rad(-18),
					0,
					wobble
				)
		end

		if waist then
			waist.Transform =
				CFrame.Angles(
					math.rad(-10),
					0,
					-wobble
				)
		end

		if leftShoulder then
			leftShoulder.Transform =
				CFrame.Angles(
					math.rad(-65),
					math.rad(-8),
					math.rad(-18)
				)
		end

		if rightShoulder then
			rightShoulder.Transform =
				CFrame.Angles(
					math.rad(-65),
					math.rad(8),
					math.rad(18)
				)
		end

		if leftHip then
			leftHip.Transform =
				CFrame.Angles(
					math.rad(35),
					0,
					math.rad(-4)
				)
		end

		if rightHip then
			rightHip.Transform =
				CFrame.Angles(
					math.rad(35),
					0,
					math.rad(4)
				)
		end

	else

		-- Hovering Superman pose
		-- Left foot slightly raised

		if rootJoint then
			rootJoint.Transform =
				CFrame.Angles(
					math.rad(-8) + wobble,
					0,
					math.rad(2)
				)
		end

		if waist then
			waist.Transform =
				CFrame.Angles(
					math.rad(-5),
					0,
					0
				)
		end

		if leftShoulder then
			leftShoulder.Transform =
				CFrame.Angles(
					math.rad(-55),
					math.rad(-12),
					math.rad(-15)
				)
		end

		if rightShoulder then
			rightShoulder.Transform =
				CFrame.Angles(
					math.rad(-55),
					math.rad(12),
					math.rad(15)
				)
		end

		if leftHip then
			leftHip.Transform =
				CFrame.Angles(
					math.rad(18),
					0,
					math.rad(-6)
				)
		end

		if rightHip then
			rightHip.Transform =
				CFrame.Angles(
					math.rad(-8),
					0,
					math.rad(3)
				)
		end
	end
end

