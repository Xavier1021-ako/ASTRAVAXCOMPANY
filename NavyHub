--========================================================
-- MOTOR HELPERS
--========================================================

local function Motor(...)
	if not Character then return nil end

	for _, name in ipairs({...}) do
		local obj = Character:FindFirstChild(name, true)

		if obj and obj:IsA("Motor6D") then
			return obj
		end
	end

	return nil
end

local function ResetAnimation()
	if not Character then return end

	for _, obj in ipairs(Character:GetDescendants()) do
		if obj:IsA("Motor6D") then
			obj.Transform = CFrame.identity
		end
	end
end

--========================================================
-- ANIMATIONS
--========================================================

local function FlightAnimation(t, moving)
	local RS = Motor("Right Shoulder", "RightShoulder")
	local LS = Motor("Left Shoulder", "LeftShoulder")
	local RH = Motor("Right Hip", "RightHip")
	local LH = Motor("Left Hip", "LeftHip")
	local Waist = Motor("Waist")

	if moving then
		if Waist then
			Waist.Transform = CFrame.Angles(math.rad(-18), 0, 0)
		end

		if RS then
			RS.Transform = CFrame.Angles(math.rad(-25), 0, math.rad(18))
		end

		if LS then
			LS.Transform = CFrame.Angles(math.rad(-25), 0, math.rad(-18))
		end

		if RH then
			RH.Transform = CFrame.Angles(math.rad(8), 0, 0)
		end

		if LH then
			LH.Transform = CFrame.Angles(math.rad(8), 0, 0)
		end
	else
		local hover = math.sin(t * 3) * 5

		if Waist then
			Waist.Transform = CFrame.Angles(math.rad(hover), 0, 0)
		end

		if RS then
			RS.Transform = CFrame.Angles(math.rad(hover), 0, math.rad(12))
		end

		if LS then
			LS.Transform = CFrame.Angles(math.rad(hover), 0, math.rad(-12))
		end
	end
end

local function SpeedAnimation(t)
	local RS = Motor("Right Shoulder", "RightShoulder")
	local LS = Motor("Left Shoulder", "LeftShoulder")
	local RH = Motor("Right Hip", "RightHip")
	local LH = Motor("Left Hip", "LeftHip")

	local a = math.sin(t * 14)
	local b = math.sin(t * 14 + math.pi)

	if RS then
		RS.Transform = CFrame.Angles(math.rad(25 * b), 0, math.rad(8))
	end

	if LS then
		LS.Transform = CFrame.Angles(math.rad(25 * a), 0, math.rad(-8))
	end

	if RH then
		RH.Transform = CFrame.Angles(math.rad(28 * a), 0, 0)
	end

	if LH then
		LH.Transform = CFrame.Angles(math.rad(28 * b), 0, 0)
	end
end

local function AbilityAnimation(t)
	local RS = Motor("Right Shoulder", "RightShoulder")
	local LS = Motor("Left Shoulder", "LeftShoulder")
	local Waist = Motor("Waist")

	local pulse = math.sin(t * 18)

	if Waist then
		Waist.Transform = CFrame.Angles(math.rad(-8), 0, 0)
	end

	if RS then
		RS.Transform = CFrame.Angles(
			math.rad(-65 + pulse * 10),
			0,
			math.rad(30)
		)
	end

	if LS then
		LS.Transform = CFrame.Angles(
			math.rad(-65 - pulse * 10),
			0,
			math.rad(-30)
		)
	end
end

local function PlayAnimation(name, duration)
	ANIMATION = name

	task.delay(duration, function()
		if ANIMATION == name then
			ANIMATION = nil
		end
	end)
end

RunService.RenderStepped:Connect(function(dt)
	AnimationTime += dt

	if ANIMATION == "Ability" then
		AbilityAnimation(AnimationTime)
	elseif FLYING then
		FlightAnimation(
			AnimationTime,
			Humanoid.MoveDirection.Magnitude > 0.05
		)
	elseif EMPEROR then
		SpeedAnimation(AnimationTime)
	else
		ResetAnimation()
	end
end)

--========================================================
-- VOID EFFECTS
--========================================================

local function Burst(position, size)
	if not EFFECTS then return end

	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(3, 3, 3)
	part.Position = position
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = Purple
	part.Transparency = 0.2
	part.Parent = workspace

	TweenService:Create(
		part,
		TweenInfo.new(0.7, Enum.EasingStyle.Exponential),
		{
			Size = size or Vector3.new(60, 60, 60),
			Transparency = 1
		}
	):Play()

	Debris:AddItem(part, 1)
end

local function Ring(position)
	if not EFFECTS then return end

	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.2, 3, 3)
	ring.CFrame =
		CFrame.new(position) *
		CFrame.Angles(0, 0, math.rad(90))

	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.Material = Enum.Material.Neon
	ring.Color = BrightPurple
	ring.Transparency = 0.2
	ring.Parent = workspace

	TweenService:Create(
		ring,
		TweenInfo.new(0.7, Enum.EasingStyle.Exponential),
		{
			Size = Vector3.new(0.2, 65, 65),
			Transparency = 1
		}
	):Play()

	Debris:AddItem(ring, 1)
end

local function Afterimage()
	if not EFFECTS or not Character then return end

	local folder = Instance.new("Folder")
	folder.Name = "VoidAfterimage"
	folder.Parent = workspace

	for _, obj in ipairs(Character:GetDescendants()) do
		if obj:IsA("BasePart")
			and obj.Name ~= "HumanoidRootPart"
			and obj.Transparency < 1 then

			local ghost = Instance.new("Part")
			ghost.Size = obj.Size
			ghost.CFrame = obj.CFrame
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanTouch = false
			ghost.CanQuery = false
			ghost.Material = Enum.Material.Neon
			ghost.Color = Purple
			ghost.Transparency = 0.55
			ghost.Parent = folder

			TweenService:Create(
				ghost,
				TweenInfo.new(0.6),
				{Transparency = 1}
			):Play()
		end
	end

	Debris:AddItem(folder, 0.8)
end

