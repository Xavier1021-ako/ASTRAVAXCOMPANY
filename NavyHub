function CreateVoidExplosion(Position, Size)

	local Ring = Instance.new("Frame")

	Ring.AnchorPoint =
		Vector2.new(0.5, 0.5)

	Ring.Position =
		Position or
		UDim2.fromScale(0.5, 0.5)

	Ring.Size =
		UDim2.fromOffset(20, 20)

	Ring.BackgroundTransparency = 1
	Ring.BorderSizePixel = 0
	Ring.ZIndex = 30
	Ring.Parent = Space

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius =
		UDim.new(1, 0)
	Corner.Parent = Ring

	local Glow = Instance.new("UIStroke")
	Glow.Color = PURPLE2
	Glow.Thickness = 5
	Glow.Transparency = 0.05
	Glow.Parent = Ring

	local TargetSize =
		Size or 300

	TweenService:Create(
		Ring,
		TweenInfo.new(
			0.9,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Size =
				UDim2.fromOffset(
					TargetSize,
					TargetSize
				)
		}
	):Play()

	TweenService:Create(
		Glow,
		TweenInfo.new(
			0.9,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Transparency = 1
		}
	):Play()

	task.delay(0.95, function()

		if Ring then
			Ring:Destroy()
		end
	end)
end

