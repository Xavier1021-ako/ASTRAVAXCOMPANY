local elapsed=0
local afterimageClock=0
RunService.RenderStepped:Connect(function(dt)
	elapsed+=dt
	if root and root.Parent then
		hole.Position=root.Position
		ring.CFrame=CFrame.new(root.Position)*CFrame.Angles(math.rad(68),elapsed*.4,0)
	end
	if hum and hum.Health>0 and not flying then
		hum.WalkSpeed=speed and RUN_SPEED or DEFAULT_SPEED
	end
	if noclip and char then
		for _,part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide=false end
		end
	end
	if flying and root and root.Parent and flightVelocity and flightGyro and hum then
		local camera=workspace.CurrentCamera
		local move=hum.MoveDirection
		local dir=Vector3.zero
		if move.Magnitude>.01 then dir=Vector3.new(move.X,0,move.Z) end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir+=Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir-=Vector3.yAxis end
		if dir.Magnitude>.01 then dir=dir.Unit*FLY_SPEED end
		flightVelocity.Velocity=dir
		if camera then
			flightGyro.CFrame=CFrame.lookAt(root.Position,root.Position+camera.CFrame.LookVector)
		end
	end
	if emperor and char and os.clock()-afterimageClock>=.18 then
		afterimageClock=os.clock()
		local model=Instance.new("Model",voidFolder)
		for _,part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then
				local clone=part:Clone()
				clone.Anchored=true
				clone.CanCollide=false
				clone.CanTouch=false
				clone.CanQuery=false
				clone.Material=Enum.Material.Neon
				clone.Color=PURPLE
				clone.Transparency=.6
				clone.Parent=model
				TweenService:Create(clone,TweenInfo.new(.35),{Transparency=1}):Play()
			end
		end
		Debris:AddItem(model,.4)
	end
end)

