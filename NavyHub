local function destroyFlightObjects()
	if flightVelocity then flightVelocity:Destroy();flightVelocity=nil end
	if flightGyro then flightGyro:Destroy();flightGyro=nil end
end

local function setSpeed(on)
	speed=on
	if hum and not flying then hum.WalkSpeed=on and RUN_SPEED or DEFAULT_SPEED end
end

