local function StartFlight()
	if Flying or not Root then return end

	Flying=true
	Humanoid.AutoRotate=false
	Humanoid.PlatformStand=false

	Attachment=Instance.new("Attachment")
	Attachment.Name="VoidFlightAttachment"
	Attachment.Parent=Root

	Velocity=Instance.new("LinearVelocity")
	Velocity.Name="VoidFlightVelocity"
	Velocity.Attachment0=Attachment
	Velocity.RelativeTo=Enum.ActuatorRelativeTo.World
	Velocity.MaxForce=math.huge
	Velocity.VectorVelocity=Vector3.zero
	Velocity.Parent=Root

	Orientation=Instance.new("AlignOrientation")
	Orientation.Name="VoidFlightOrientation"
	Orientation.Attachment0=Attachment
	Orientation.Mode=Enum.OrientationAlignmentMode.OneAttachment
	Orientation.MaxTorque=math.huge
	Orientation.Responsiveness=25
	Orientation.Parent=Root

	FlightButton.Text="Void Flight • ACTIVE"
	Status.Text="VOID FLIGHT // JOYSTICK CONTROL"

	FlightConnection=RunService.RenderStepped:Connect(function(dt)
		if not Flying or not Root then return end

		local camera=workspace.CurrentCamera
		if not camera then return end

		local move=Humanoid.MoveDirection
		local direction=Vector3.zero

		if move.Magnitude>.01 then
			local look=camera.CFrame.LookVector
			local right=camera.CFrame.RightVector

			local forward=Vector3.new(
				look.X,
				0,
				look.Z
			)

			local side=Vector3.new(
				right.X,
				0,
				right.Z
			)

			if forward.Magnitude>.01 then
				forward=forward.Unit
			end

			if side.Magnitude>.01 then
				side=side.Unit
			end

			local forwardAmount=move:Dot(forward)
			local sideAmount=move:Dot(side)

			direction=
				forward*forwardAmount+
				side*sideAmount

			direction+=Vector3.new(
				0,
				look.Y*math.abs(forwardAmount),
				0
			)

			if direction.Magnitude>.01 then
				direction=direction.Unit
			end
		end

		local target=direction*FLIGHT_SPEED

		Velocity.VectorVelocity=
			Velocity.VectorVelocity:Lerp(
				target,
				math.clamp(dt*10,0,1)
			)

		if direction.Magnitude>.01 then
			Orientation.CFrame=
				CFrame.lookAt(
					Root.Position,
					Root.Position+direction
				)
		end

		if Effects
			and direction.Magnitude>.01
			and math.random()<.12 then
			Afterimage()
		end
	end)
end

local function StopFlight()
	if not Flying then return end

	Flying=false

	if FlightConnection then
		FlightConnection:Disconnect()
		FlightConnection=nil
	end

	if Velocity then
		Velocity:Destroy()
		Velocity=nil
	end

	if Orientation then
		Orientation:Destroy()
		Orientation=nil
	end

	if Attachment then
		Attachment:Destroy()
		Attachment=nil
	end

	Humanoid.AutoRotate=true
	Humanoid.WalkSpeed=Emperor and SPEED or 16

	if Root then
		Burst(Root.Position)
		Ring(Root.Position)
	end

	FlightButton.Text="Void Flight"

	Status.Text=
		Emperor
		and "VOID EMPEROR // 190 SPEED"
		or "SYSTEM READY"
end

local function ToggleFlight()
	if Flying then
		StopFlight()
	else
		StartFlight()
	end
end

local function VoidAbility()
	if not AbilityReady or not Root then return end

	AbilityReady=false

	PlayAnimation("Ability",.8)

	Status.Text="VOID ABILITY // CASTING"

	Burst(
		Root.Position,
		Vector3.new(75,75,75)
	)

	Ring(Root.Position)
	Afterimage()

	task.delay(.8,function()
		Status.Text=
			Flying
			and "VOID FLIGHT // JOYSTICK CONTROL"
			or Emperor
				and "VOID EMPEROR // 190 SPEED"
				or "SYSTEM READY"
	end)

	task.delay(.1,function()
		AbilityReady=true
	end)
end

