			}
		):Play()
	end)

	Button.MouseLeave:Connect(function()
		TweenService:Create(
			Button,
			TweenInfo.new(0.15),
			{
				BackgroundColor3 = Color3.fromRGB(15, 10, 24)
			}
		):Play()

		TweenService:Create(
			Glow,
			TweenInfo.new(0.15),
			{
				Transparency = 0.65
			}
		):Play()
	end)

	Button.MouseButton1Click:Connect(function()
		TweenService:Create(
			Button,
			TweenInfo.new(0.08),
			{
				Size = UDim2.new(1, -11, 0, 34)
