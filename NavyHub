local function SwitchSection(Name, Button)
	CurrentSection = Name

	for _, Object in ipairs(Sidebar:GetChildren()) do
		if Object:IsA("TextButton") then
			TweenService:Create(
				Object,
				TweenInfo.new(0.15),
				{
					BackgroundColor3 = DARK2
				}
			):Play()

			local Stroke = Object:FindFirstChildOfClass("UIStroke")

			if Stroke then
				Stroke.Transparency = 1
			end
		end
	end

	local SelectedStroke = Button:FindFirstChildOfClass("UIStroke")

	TweenService:Create(
		Button,
		TweenInfo.new(0.18),
		{
			BackgroundColor3 = Color3.fromRGB(38, 17, 60)
		}
	):Play()

	if SelectedStroke then
		SelectedStroke.Transparency = 0.25
	end

	for _, Page in ipairs(Content:GetChildren()) do
		if Page:IsA("ScrollingFrame") then
			Page.Visible = Page.Name == Name
		end
	end
end

