--==================================================
-- VOID AFTERIMAGE
--==================================================

local LastAfterimage = 0

local function CreateVoidAfterimage()

	if not VoidEmperor then
		return
	end

	if not Afterimages then
		return
	end

	if not Character then
		return
	end

	if os.clock() - LastAfterimage < 0.14 then
		return
	end

	LastAfterimage = os.clock()

	local Ghost = Instance.new("Model")
	Ghost.Name = "NavyVoidAfterimage"

	for _, Object in ipairs(
		Character:GetChildren()
	) do

		if Object:IsA("BasePart")
			and Object.Name ~= "HumanoidRootPart" then

			local Clone = Object:Clone()

			for _, Child in ipairs(
				Clone:GetDescendants()
			) do

				if Child:IsA("Script")
					or Child:IsA("LocalScript")
					or Child:IsA("ModuleScript") then

					Child:Destroy()

				elseif Child:IsA("Decal") then
					Child.Transparency = 1
				end
			end

			Clone.Anchored = true
			Clone.CanCollide = false
			Clone.Material = Enum.Material.Neon
			Clone.Color = PURPLE
			Clone.Transparency = 0.58
			Clone.Parent = Ghost
		end
	end

	Ghost.Parent = workspace

	for _, Part in ipairs(
		Ghost:GetDescendants()
	) do

		if Part:IsA("BasePart") then

			TweenService:Create(
				Part,
				TweenInfo.new(
					0.35,
					Enum.EasingStyle.Sine
				),
				{
